{
  "name": "ableton-sdk-mcp-kernel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Ableton Extensions SDK extension hosting the WebSocket bridge (ws://127.0.0.1:17890) the MCP server proxies to. All Live API access happens here.",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsx build.ts",
    "build:prod": "tsx build.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node test/test-kernel.mjs",
    "bridge": "tsx scripts/bridge.ts",
    "bridge:restart": "tsx scripts/bridge.ts --restart",
    "dev": "tsx build.ts && extensions-cli run",
    "package": "tsx build.ts --production && extensions-cli package"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:../../ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:../../ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
