{
  "name": "ableton-sound-intents",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsx build.ts",
    "build:prod": "tsx build.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/soundIntents.test.ts",
    "start": "bash scripts/dev.sh",
    "run": "tsx build.ts && extensions-cli run",
    "logs": "bash scripts/tail-host-log.sh",
    "package": "tsx build.ts --production && extensions-cli package"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:../../../ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:../../../ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
